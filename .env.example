# CeylonCare AI Environment Variables
# -----------------------------------------------
# Copy this file to `.env` and fill in your keys.
# NEVER commit the actual `.env` file to GitHub.
# -----------------------------------------------

# Google Gemini API (Primary LLM & Vision Engine)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API (Secondary LLM Fallback)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# WHO ICD-11 Clinical Coding API (for Medical Knowledge Agent)
# Register at: https://icd.who.int/icdapi
WHO_ICD_CLIENT_ID=your_who_client_id_here
WHO_ICD_CLIENT_SECRET=your_who_client_secret_here

# LangSmith Observability (Optional, for full telemetry tracing)
# Get your free key at: https://smith.langchain.com/
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_key_here
# LANGCHAIN_PROJECT=ceyloncare-agentic-ai
